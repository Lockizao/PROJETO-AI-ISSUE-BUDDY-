# Copie este arquivo para .env.local e preencha com suas próprias chaves.
# Nunca commite o .env.local real — ele contém credenciais.

# Chave gerada em https://aistudio.google.com/apikey
GEMINI_API_KEY=sua_chave_aqui

# Token gerado em https://github.com/settings/tokens
# (fine-grained, "Public repositories" já é suficiente para ler issues públicas)
GITHUB_PAT=seu_token_aqui
